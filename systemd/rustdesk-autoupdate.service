[Unit]
Description=Update RustDesk from configured APT sources
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/bin/apt-get

[Service]
Type=oneshot
Environment=DEBIAN_FRONTEND=noninteractive
ExecStart=/usr/bin/apt-get -o Dpkg::Lock::Timeout=120 update
ExecStart=/usr/bin/apt-get -o Dpkg::Lock::Timeout=120 -y --only-upgrade install rustdesk
Nice=10
